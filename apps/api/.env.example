# apps/api/.env.example
#
# Copy this file, then edit the copy:
#
#   cp apps/api/.env.example apps/api/.env      # or: make env
#
# The Makefile loads ./.env automatically when it exists and exports it to
# recipes (make run, make test, ...). Keep every value here fake.
#
# HTTP and DATABASE_URL keys below are REQUIRED. AWS settings are needed only when opting into
# the development S3 upload flow. Leave it disabled until these are configured.
# Deployed environments inject settings and use an IAM role for credentials.
#
# Format notes:
#   - one KEY=value per line, no quotes needed for simple values
#   - comments must sit on their own line (no trailing "# ..." after a value)
#   - durations use Go syntax: 500ms, 5s, 2m, 1h

# --- HTTP server -----------------------------------------------------

# host:port to listen on. ":8080" binds all interfaces.
API_ADDR=:8080

# Free-form deployment label: development | test | production
API_ENV=development

# Minimum log level emitted as JSON: debug | info | warn | error
API_LOG_LEVEL=info

# --- Timeouts (must be positive) -------------------------------------

# Budget for reading request headers (slowloris protection).
API_READ_HEADER_TIMEOUT=5s

# Budget for reading an entire request, including the body.
API_READ_TIMEOUT=30s

# Budget for writing a response. Raise this once endpoints stream or render.
API_WRITE_TIMEOUT=30s

# How long an idle keep-alive connection is kept open.
API_IDLE_TIMEOUT=120s

# Grace period for in-flight requests after SIGTERM/SIGINT.
API_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL (required; use your provider's TLS settings) ------------

# Fake local example only. Never log this URL or put it in the mobile app.
# sslmode=disable is for a local development database, not a hosted database.
DATABASE_URL=postgres://clip_ai:fake-password@localhost:5432/clip_ai?sslmode=disable

# --- Redis / Asynq producer (loaded separately by queue users) ----------

# Host-run Go process -> local Docker Redis published on port 6379.
# Require explicit host:port; optional /database defaults to 0.
# Hosted example: rediss://username:URL-encoded-password@host:6380/0
# Use provider TLS settings; never disable certificate verification.
# No query parameters, Sentinel, Cluster or socket URLs in this first slice.
# Never log this URL. Keep it server-side and out of mobile configuration.
# Existing HTTP startup does not load it until task producers are wired in.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Outbox dispatcher (separate process; do NOT enable without a worker) --

# Enabling forwards pending tasks into Redis. It does not validate videos.
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_POLL_INTERVAL=1s
# Total row-lock/transaction budget; must exceed the Redis enqueue budget.
OUTBOX_TRANSACTION_TIMEOUT=10s
OUTBOX_ENQUEUE_TIMEOUT=3s
# Capped exponential retry delay with equal jitter.
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=5m

# --- Media processing (separate worker; approved migration 00006 required) --

# Opt-in validation and audio preparation after upload.
# Requires migrated schema before enabling; never silently backfills old assets.
MEDIA_PREPARATION_ENABLED=false
# The combined worker and feature switch must both be enabled explicitly.
MEDIA_PREPARATION_WORKER_ENABLED=false
# Absolute private 0700 root; at least 8 GiB free.
MEDIA_PREPARATION_TEMP_DIR=/var/tmp/clip-ai-preparation
# Fixed policy: concurrency 1, two durable attempts total, one native retry;
# download 15m, encode 60m, uploads 10m, whole task 90m; lease 91m, expiry 92m.
# Reuses DATABASE_URL / REDIS_URL / AWS_REGION / S3_BUCKET.
# IAM: GetObject originals, conditional private derived-only writes; no deletes.
# Unpublished private derivatives need a separately approved retention/GC policy.

# Clerk application: Chorus Clip. Set real values locally, never in mobile code.
# Issuer is the exact Frontend API origin from this application's Dashboard.
CLERK_ISSUER=https://relieved-feline-5594.clerk.accounts.dev
CLERK_SECRET_KEY=
# Optional: require an audience only if configured on your session token.
CLERK_AUDIENCE=
# Native sessions may omit azp. Present azp MUST match this comma-separated list.
# Leave empty to reject all present azp values; add only trusted client origins.
CLERK_AUTHORIZED_PARTIES=

# --- Development-only stateless S3 uploads ----------------------------

# Explicit opt-in. Must remain false outside a controlled development machine.
# API_ENV must be development; enabling this in other environments fails startup.
DEV_S3_UPLOAD_ENABLED=false

# Generate your own random secret, e.g. openssl rand -hex 32. Keep it stable
# across restarts while uploads are in progress; at least 32 bytes, server only.
# This signs upload capabilities, NOT login sessions. Never expose it to mobile.
UPLOAD_TOKEN_SECRET=
UPLOAD_TOKEN_TTL=24h

# --- AWS S3 (required when DEV_S3_UPLOAD_ENABLED=true) ------------------

# Region containing your private bucket, e.g. ap-south-1.
AWS_REGION=
S3_BUCKET=

# Required by config.LoadS3 when the adapter is used; must be between 1s and 15m.
S3_PRESIGN_TTL=15m

# Optional local CLI profile name; leave blank to use the default chain/profile.
# Uses ~/.aws/config and ~/.aws/credentials, including configured SSO profiles.
# For SSO, sign in separately: aws sso login --profile your-profile
AWS_PROFILE=

# Optional alternative for local temporary credentials, NOT needed with a CLI
# profile or IAM role. Never put real values in this example or in mobile code.
# AWS_SESSION_TOKEN is needed only when using temporary credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Enabling the flow constructs the SDK client; API upload requests perform real
# AWS calls and can incur charges. Bucket setup is not performed automatically.
# Use a private bucket, least-privilege IAM, and an
# AbortIncompleteMultipartUpload lifecycle rule before real use.
# There is no persistent create-request deduplication. Do not blindly retry
# POST /uploads after a lost response; abandoned parts need lifecycle cleanup.

# --- S3 transcript files (approved migration 00008 required) -------------
# Producer opt-in: preparation-ready publication atomically enqueues a job.
# Older ready assets and historical inline transcripts are NOT backfilled.
TRANSCRIPT_FILES_ENABLED=false
# Separate consumer; do not enable before the migration and worker are ready.
TRANSCRIPTION_WORKER_ENABLED=false
DEEPGRAM_API_KEY=
# multi covers te/hi/en/ta/kn; Malayalam requires an explicit ml override.
# This worker-wide setting is snapshotted at enqueue time, not a language guess.
TRANSCRIPTION_LANGUAGE=multi
# Use a separate private absolute 0700 root, not the preparation root.
TRANSCRIPTION_TEMP_DIR=/var/tmp/clip-ai-transcription
# Reuses DATABASE_URL, REDIS_URL, AWS_REGION and S3_BUCKET.
# Fixed: concurrency 1/process, two attempts, download 10m, provider 12m,
# upload 2m, task 25m, claim 26m. A crash can cause duplicate provider charges.
# Private transcript JSON uses immutable derived-only writes; no public ACL.

# --- Curation consumer (approved migration 00009 required) ---------------
# Separate opt-in process. Do not activate without explicit approval.
CURATION_WORKER_ENABLED=false
CURATION_SERVICE_URL=http://127.0.0.1:8090/internal/curate
# Must match apps/llm CURATION_SERVICE_TOKEN; never use a Clerk/provider key.
CURATION_SERVICE_TOKEN=
CURATION_TEMP_DIR=/var/tmp/clip-ai-curation
# Reuses DATABASE_URL, REDIS_URL, AWS_REGION and S3_BUCKET; no Groq key in Go.
# Plain HTTP is loopback-only; other hosts require HTTPS. No redirects/proxies.
# One task/process: download 30s, service 70s (LLM overall 65s), task 2m,
# claim 3m, retry 1m, pending-delivery recovery 5m, at most two durable claims.
# Recovery runs every minute. Crashes can still duplicate paid calls.
