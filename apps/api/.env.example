# apps/api/.env.example
#
# Copy this file, then edit the copy:
#
#   cp apps/api/.env.example apps/api/.env      # or: make env
#
# The Makefile loads ./.env automatically when it exists and exports it to
# recipes (make run, make test, ...). Keep every value here fake.
#
# HTTP keys below are REQUIRED. AWS settings are placeholders for the storage
# adapter; the upload session service is not connected to the routes yet.
# Deployed environments inject settings and use an IAM role for credentials.
#
# Format notes:
#   - one KEY=value per line, no quotes needed for simple values
#   - comments must sit on their own line (no trailing "# ..." after a value)
#   - durations use Go syntax: 500ms, 5s, 2m, 1h

# --- HTTP server -----------------------------------------------------

# host:port to listen on. ":8080" binds all interfaces.
API_ADDR=:8080

# Free-form deployment label: development | test | production
API_ENV=development

# Minimum log level emitted as JSON: debug | info | warn | error
API_LOG_LEVEL=info

# --- Timeouts (must be positive) -------------------------------------

# Budget for reading request headers (slowloris protection).
API_READ_HEADER_TIMEOUT=5s

# Budget for reading an entire request, including the body.
API_READ_TIMEOUT=30s

# Budget for writing a response. Raise this once endpoints stream or render.
API_WRITE_TIMEOUT=30s

# How long an idle keep-alive connection is kept open.
API_IDLE_TIMEOUT=120s

# Grace period for in-flight requests after SIGTERM/SIGINT.
API_SHUTDOWN_TIMEOUT=15s

# --- AWS S3 (fill these in when connecting the upload service) ----------

# Region containing your private bucket, e.g. ap-south-1.
AWS_REGION=
S3_BUCKET=

# Required by config.LoadS3 when the adapter is used; must be between 1s and 15m.
S3_PRESIGN_TTL=15m

# Optional local CLI profile name; leave blank to use the default chain/profile.
# Uses ~/.aws/config and ~/.aws/credentials, including configured SSO profiles.
# For SSO, sign in separately: aws sso login --profile your-profile
AWS_PROFILE=

# Optional alternative for local temporary credentials, NOT needed with a CLI
# profile or IAM role. Never put real values in this example or in mobile code.
# AWS_SESSION_TOKEN is needed only when using temporary credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# No SDK calls or bucket setup occur just by filling these placeholders.
# The future upload service must use a private bucket, least-privilege IAM,
# and an AbortIncompleteMultipartUpload lifecycle rule before real use.
