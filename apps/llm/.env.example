HOST=127.0.0.1
PORT=8090

# Enabled by default; requires the service token and Groq key below.
# Set false explicitly for a health-only server without provider credentials.
CURATION_ENABLED=true
# Generate a private random token (32–256 base64url characters); share only with Go.
CURATION_SERVICE_TOKEN=
GROQ_API_KEY=
# Optional path to the shipped v1 prompt; defaults to src/prompts/curate/v1.md.
# CURATION_PROMPT_PATH=/absolute/private/deployment/path/to/v1.md
