# Public API address only. NEVER add AWS access keys, upload signing secrets,
# AWS profiles, or Upload-Token values to mobile environment variables.
# Copy to .env.local and set a URL reachable from your phone/emulator.
# A physical phone's localhost is the phone, not the machine running Go.
# Example dev LAN URL: http://192.168.1.10:8080 (replace with your machine's IP).
# Prefer HTTPS; native development builds may require local HTTP configuration.
EXPO_PUBLIC_API_URL=
# Clerk publishable key only; configure locally for Chorus Clip.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
